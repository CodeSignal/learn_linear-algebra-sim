{
  "name": "codesignal-linear-algebra-playground",
  "version": "0.0.1",
  "description": "An interactive educational tool for learning linear algebra through visual experimentation.",
  "main": "server.js",
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "concurrently \"npm run dev:vite\" \"npm run dev:api\"",
    "dev": "npm run start:dev",
    "dev:vite": "vite",
    "dev:api": "API_ONLY=true PORT=3001 node server.js",
    "start:prod": "node server.js",
    "build": "node build.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.27.0",
    "vite": "^7.2.4"
  }
}
